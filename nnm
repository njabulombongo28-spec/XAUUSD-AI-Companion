name: Build XAUUSD Android App

on:
  workflow_dispatch:
  push:
    paths:
      - 'XAUUSD_AI_Android_Companion.zip'
      - '.github/workflows/build-apk.yml'

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: Extract app
        run: unzip XAUUSD_AI_Android_Companion.zip

      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      - uses: android-actions/setup-android@v3

      - uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: '8.7'

      - name: Build APK
        run: gradle -p XAUUSD_AI_Android_Companion/android :app:assembleDebug

      - uses: actions/upload-artifact@v4
        with:
          name: XAUUSD-AI-Companion-APK
          path: XAUUSD_AI_Android_Companion/android/app/build/outputs/apk/debug/app-debug.apk